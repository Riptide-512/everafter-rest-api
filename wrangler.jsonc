{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everafter-rest-api",
  "main": "src/index.js",
  "compatibility_date": "2026-03-14",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "projects_db",
      "database_id": "de6dc47a-f232-43f5-ad10-81175f8e3bda",
      "migrations_dir": "./src/data/migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60,
      },
    },
  ],
}
